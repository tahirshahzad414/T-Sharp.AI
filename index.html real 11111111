<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>T-Sharp AI</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Syne:wght@400;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0f;
    --surface: #12121a;
    --card: #1a1a28;
    --accent: #7c6af7;
    --accent2: #f76a8c;
    --accent3: #6af7c8;
    --text: #e8e8f0;
    --muted: #6b6b8a;
    --glow: rgba(124,106,247,0.3);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Space Grotesk', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  body::before {
    content: '';
    position: fixed;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(124,106,247,0.12) 0%, transparent 70%);
    top: -100px; left: -100px;
    pointer-events: none;
    animation: drift1 8s ease-in-out infinite alternate;
  }
  body::after {
    content: '';
    position: fixed;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(247,106,140,0.09) 0%, transparent 70%);
    bottom: -80px; right: -80px;
    pointer-events: none;
    animation: drift2 10s ease-in-out infinite alternate;
  }
  @keyframes drift1 { from{transform:translate(0,0);}to{transform:translate(60px,40px);} }
  @keyframes drift2 { from{transform:translate(0,0);}to{transform:translate(-40px,-60px);} }

  /* ====== WELCOME SCREEN ====== */
  #welcome-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    animation: fadeUp 1s ease both;
    z-index: 10;
    padding: 20px;
  }

  .logo-ring {
    width: 120px; height: 120px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    box-shadow: 0 0 40px var(--glow), inset 0 0 30px rgba(124,106,247,0.08);
    animation: pulseRing 3s ease-in-out infinite;
  }
  .logo-ring::before {
    content:''; position:absolute; width:100%; height:100%;
    border-radius:50%; border:1px solid rgba(124,106,247,0.3);
    animation: expandRing 3s ease-in-out infinite;
  }
  .logo-ring::after {
    content:''; position:absolute; width:100%; height:100%;
    border-radius:50%; border:1px solid rgba(106,247,200,0.2);
    animation: expandRing 3s ease-in-out infinite 0.5s;
  }
  @keyframes pulseRing {
    0%,100%{box-shadow:0 0 40px var(--glow),inset 0 0 30px rgba(124,106,247,0.08);}
    50%{box-shadow:0 0 70px var(--glow),inset 0 0 50px rgba(124,106,247,0.15);}
  }
  @keyframes expandRing {
    0%{transform:scale(1);opacity:0.6;}100%{transform:scale(1.4);opacity:0;}
  }

  /* AI Logo Icon — professional circuit/AI symbol */
  .logo-svg {
    width: 56px; height: 56px;
    filter: drop-shadow(0 0 14px var(--accent));
  }

  .brand-name {
    font-family: 'Syne', sans-serif;
    font-size: 48px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent), var(--accent2), var(--accent3));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -1px;
    line-height: 1;
  }

  .brand-sub {
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-top: 4px;
    text-align: center;
  }

  .tagline {
    font-size: 16px;
    color: var(--muted);
    text-align: center;
    max-width: 300px;
    line-height: 1.65;
  }

  .call-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, var(--accent), #9b5de5);
    border: none;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
    padding: 16px 40px;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px var(--glow);
    letter-spacing: 0.5px;
    margin-top: 8px;
  }
  .call-btn:hover { transform:translateY(-2px) scale(1.03); box-shadow:0 16px 48px var(--glow); }

  /* Plus/AI icon in button */
  .btn-plus {
    width: 24px; height: 24px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex; align-items:center; justify-content:center;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
  }

  /* ====== CHAT SCREEN ====== */
  #chat-screen {
    display: none;
    flex-direction: column;
    width: 100%;
    max-width: 680px;
    height: 100vh;
    max-height: 100vh;
    z-index: 10;
    animation: fadeUp 0.6s ease both;
  }

  /* Header */
  .chat-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--surface);
    border-bottom: 1px solid rgba(124,106,247,0.15);
    flex-shrink: 0;
    position: relative;
  }

  .agent-avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: flex; align-items:center; justify-content:center;
    box-shadow: 0 0 20px var(--glow);
    position: relative;
    flex-shrink: 0;
  }
  .agent-avatar svg { width:22px; height:22px; filter:drop-shadow(0 0 6px rgba(255,255,255,0.5)); }

  .status-dot {
    position: absolute;
    width: 11px; height: 11px;
    background: var(--accent3);
    border-radius: 50%;
    bottom: 1px; right: 1px;
    border: 2px solid var(--surface);
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1;}50%{opacity:0.3;} }

  .agent-info { flex: 1; }
  .agent-name {
    font-family:'Syne',sans-serif;
    font-weight:700;
    font-size:16px;
    color:var(--text);
    display:flex; align-items:center; gap:6px;
  }
  .agent-status { font-size:11px; color:var(--accent3); letter-spacing:0.5px; margin-top:1px; }

  /* Three dot menu */
  .menu-btn {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 20px;
    padding: 6px 10px;
    border-radius: 8px;
    transition: all 0.2s;
    line-height: 1;
    letter-spacing: 1px;
  }
  .menu-btn:hover { background:rgba(255,255,255,0.06); color:var(--text); }

  /* Dropdown menu */
  .dropdown-menu {
    display: none;
    position: absolute;
    top: 62px; right: 12px;
    background: var(--card);
    border: 1px solid rgba(124,106,247,0.25);
    border-radius: 14px;
    overflow: hidden;
    z-index: 100;
    min-width: 200px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    animation: dropIn 0.2s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  .dropdown-menu.open { display:block; }
  @keyframes dropIn {
    from{opacity:0;transform:translateY(-8px) scale(0.95);}
    to{opacity:1;transform:translateY(0) scale(1);}
  }

  .dropdown-item {
    display: flex; align-items:center; gap:10px;
    padding: 13px 18px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    transition: background 0.15s;
    border: none; background:none; width:100%; text-align:left;
    font-family:'Space Grotesk',sans-serif;
  }
  .dropdown-item:hover { background:rgba(124,106,247,0.1); }
  .dropdown-item.danger { color: var(--accent2); }
  .dropdown-item.danger:hover { background:rgba(247,106,140,0.1); }
  .dropdown-item .item-icon { font-size:16px; width:20px; text-align:center; }

  .dropdown-divider { height:1px; background:rgba(255,255,255,0.06); margin:4px 0; }

  .recents-label {
    padding: 8px 18px 4px;
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight:600;
  }

  .recent-item {
    display: flex; align-items:center; gap:10px;
    padding: 10px 18px;
    cursor: pointer;
    font-size: 13px;
    color: var(--muted);
    transition: all 0.15s;
    border:none; background:none; width:100%; text-align:left;
    font-family:'Space Grotesk',sans-serif;
    border-radius: 0;
  }
  .recent-item:hover { background:rgba(124,106,247,0.08); color:var(--text); }
  .recent-item .r-icon { font-size:13px; }

  /* Google Sign In */
  .google-btn {
    display: flex; align-items:center; justify-content:center; gap:10px;
    margin: 10px 14px 14px;
    padding: 12px 18px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    transition: all 0.2s;
    font-family:'Space Grotesk',sans-serif;
    text-decoration: none;
  }
  .google-btn:hover { background:rgba(255,255,255,0.1); border-color:rgba(255,255,255,0.2); }

  /* Messages */
  .messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
    scroll-behavior: smooth;
  }
  .messages-area::-webkit-scrollbar { width:3px; }
  .messages-area::-webkit-scrollbar-thumb { background:var(--accent); border-radius:4px; }

  .msg-row {
    display: flex; gap: 10px;
    animation: msgIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  @keyframes msgIn {
    from{opacity:0;transform:translateY(14px) scale(0.97);}
    to{opacity:1;transform:translateY(0) scale(1);}
  }
  .msg-row.user-row { flex-direction:row-reverse; }

  .msg-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    display:flex; align-items:center; justify-content:center;
    font-size:14px;
  }
  .ai-avatar-sm {
    background: linear-gradient(135deg,var(--accent),var(--accent2));
    box-shadow: 0 0 10px var(--glow);
  }
  .ai-avatar-sm svg { width:16px; height:16px; }
  .user-avatar-sm { background:var(--card); border:1px solid rgba(255,255,255,0.1); }

  .msg-bubble {
    max-width: 78%;
    padding: 12px 16px;
    border-radius: 18px;
    font-size: 14.5px;
    line-height: 1.65;
  }
  .ai-bubble {
    background: var(--card);
    border: 1px solid rgba(124,106,247,0.18);
    border-radius: 4px 18px 18px 18px;
    color: var(--text);
  }
  .user-bubble {
    background: linear-gradient(135deg, var(--accent), #9b5de5);
    border-radius: 18px 4px 18px 18px;
    color: white;
  }

  /* Typing */
  .typing-indicator {
    display:flex; gap:5px; padding:14px 16px;
    background:var(--card);
    border:1px solid rgba(124,106,247,0.18);
    border-radius:4px 18px 18px 18px;
    width:fit-content; align-items:center;
  }
  .typing-dot {
    width:7px; height:7px; border-radius:50%; background:var(--accent);
    animation: typingBounce 1.2s ease-in-out infinite;
  }
  .typing-dot:nth-child(2){animation-delay:0.2s;background:var(--accent2);}
  .typing-dot:nth-child(3){animation-delay:0.4s;background:var(--accent3);}
  @keyframes typingBounce{0%,60%,100%{transform:translateY(0);}30%{transform:translateY(-7px);}}

  /* Wave */
  .wave-bar { display:inline-flex; align-items:center; gap:2px; margin-left:6px; vertical-align:middle; }
  .wave-bar span {
    display:inline-block; width:3px; border-radius:2px; background:var(--accent3);
    animation: wave 1s ease-in-out infinite;
  }
  .wave-bar span:nth-child(1){height:5px;animation-delay:0s;}
  .wave-bar span:nth-child(2){height:10px;animation-delay:0.1s;}
  .wave-bar span:nth-child(3){height:16px;animation-delay:0.2s;}
  .wave-bar span:nth-child(4){height:10px;animation-delay:0.3s;}
  .wave-bar span:nth-child(5){height:5px;animation-delay:0.4s;}
  @keyframes wave{0%,100%{transform:scaleY(0.5);opacity:0.5;}50%{transform:scaleY(1);opacity:1;}}

  /* Input */
  .input-area {
    padding: 12px 16px 16px;
    background: var(--surface);
    border-top: 1px solid rgba(124,106,247,0.1);
    flex-shrink: 0;
  }
  .input-wrapper {
    display: flex; align-items:flex-end; gap:10px;
    background: var(--card);
    border: 1px solid rgba(124,106,247,0.25);
    border-radius: 20px;
    padding: 10px 10px 10px 16px;
    transition: border-color 0.3s;
  }
  .input-wrapper:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 18px rgba(124,106,247,0.12);
  }
  .msg-input {
    flex:1; background:none; border:none; outline:none;
    color:var(--text); font-family:'Space Grotesk',sans-serif;
    font-size:14px; resize:none; max-height:110px; min-height:20px; line-height:1.5;
  }
  .msg-input::placeholder { color:var(--muted); }

  .send-btn {
    width:36px; height:36px; border-radius:50%;
    background: linear-gradient(135deg,var(--accent),#9b5de5);
    border:none; color:white; font-size:15px; cursor:pointer;
    transition:all 0.2s; display:flex; align-items:center; justify-content:center;
    flex-shrink:0; box-shadow:0 4px 14px var(--glow);
  }
  .send-btn:hover{transform:scale(1.1);}
  .send-btn:disabled{opacity:0.4;cursor:not-allowed;transform:none;}

  /* Suggestions */
  .suggestions {
    display:flex; flex-wrap:wrap; gap:7px;
    padding: 0 16px 10px;
  }
  .suggestion-chip {
    background:rgba(124,106,247,0.1);
    border:1px solid rgba(124,106,247,0.25);
    color:var(--accent);
    font-family:'Space Grotesk',sans-serif;
    font-size:11.5px; padding:6px 13px;
    border-radius:100px; cursor:pointer; transition:all 0.2s;
  }
  .suggestion-chip:hover{background:rgba(124,106,247,0.2);transform:translateY(-1px);}

  @keyframes fadeUp{from{opacity:0;transform:translateY(28px);}to{opacity:1;transform:translateY(0);}}
  .hidden{display:none !important;}

  /* Overlay to close menu */
  #overlay {
    display:none; position:fixed; inset:0; z-index:99;
  }
  #overlay.open { display:block; }
</style>
</head>
<body>

<!-- ====== WELCOME SCREEN ====== -->
<div id="welcome-screen">

  <div class="logo-ring">
    <!-- Professional AI circuit/brain icon -->
    <svg class="logo-svg" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="28" cy="28" r="20" stroke="#7c6af7" stroke-width="1.5" fill="rgba(124,106,247,0.08)"/>
      <!-- Brain/circuit nodes -->
      <circle cx="28" cy="14" r="3" fill="#7c6af7"/>
      <circle cx="28" cy="42" r="3" fill="#f76a8c"/>
      <circle cx="14" cy="28" r="3" fill="#6af7c8"/>
      <circle cx="42" cy="28" r="3" fill="#7c6af7"/>
      <circle cx="18" cy="18" r="2.5" fill="#f76a8c"/>
      <circle cx="38" cy="18" r="2.5" fill="#6af7c8"/>
      <circle cx="18" cy="38" r="2.5" fill="#7c6af7"/>
      <circle cx="38" cy="38" r="2.5" fill="#f76a8c"/>
      <!-- Connection lines -->
      <line x1="28" y1="17" x2="28" y2="39" stroke="rgba(124,106,247,0.4)" stroke-width="1"/>
      <line x1="17" y1="28" x2="39" y2="28" stroke="rgba(124,106,247,0.4)" stroke-width="1"/>
      <line x1="20" y1="20" x2="36" y2="36" stroke="rgba(247,106,140,0.35)" stroke-width="1"/>
      <line x1="36" y1="20" x2="20" y2="36" stroke="rgba(106,247,200,0.35)" stroke-width="1"/>
      <!-- Center dot -->
      <circle cx="28" cy="28" r="4" fill="url(#cg)" />
      <defs>
        <radialGradient id="cg" cx="50%" cy="50%">
          <stop offset="0%" stop-color="#e8e8f0"/>
          <stop offset="100%" stop-color="#7c6af7"/>
        </radialGradient>
      </defs>
    </svg>
  </div>

  <div style="text-align:center;">
    <div class="brand-name">T-Sharp AI</div>
    <div class="brand-sub">T-Sharp AI – Your Intelligent Digital Companion</div>
  </div>

  <p class="tagline">Your personal AI assistant — understands you, listens carefully, and responds intelligently</p>

  <button class="call-btn" onclick="startChat()">
    <span class="btn-plus">✦</span>
    Ask T-Sharp AI
  </button>
</div>

<!-- ====== CHAT SCREEN ====== -->
<div id="chat-screen">
  <div class="chat-header">
    <div class="agent-avatar">
      <!-- Small AI icon in header -->
      <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="28" cy="28" r="20" fill="rgba(255,255,255,0.1)"/>
        <circle cx="28" cy="14" r="3" fill="white"/>
        <circle cx="28" cy="42" r="3" fill="rgba(255,255,255,0.7)"/>
        <circle cx="14" cy="28" r="3" fill="rgba(255,255,255,0.8)"/>
        <circle cx="42" cy="28" r="3" fill="white"/>
        <circle cx="18" cy="18" r="2" fill="rgba(255,255,255,0.6)"/>
        <circle cx="38" cy="18" r="2" fill="rgba(255,255,255,0.6)"/>
        <circle cx="18" cy="38" r="2" fill="rgba(255,255,255,0.6)"/>
        <circle cx="38" cy="38" r="2" fill="rgba(255,255,255,0.6)"/>
        <line x1="28" y1="17" x2="28" y2="39" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
        <line x1="17" y1="28" x2="39" y2="28" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
        <circle cx="28" cy="28" r="4" fill="white"/>
      </svg>
      <div class="status-dot"></div>
    </div>

    <div class="agent-info">
      <div class="agent-name">
        T-Sharp AI
        <span class="wave-bar" id="wave" style="display:none">
          <span></span><span></span><span></span><span></span><span></span>
        </span>
      </div>
      <div class="agent-status" id="agent-status">● Online — Ready to assist you</div>
    </div>

    <!-- Three dot menu -->
    <button class="menu-btn" onclick="toggleMenu()" title="Menu">•••</button>

    <!-- Dropdown -->
    <div class="dropdown-menu" id="dropdownMenu">
      <button class="dropdown-item danger" onclick="deleteChat()">
        <span class="item-icon">🗑️</span> Delete Chat
      </button>
      <button class="dropdown-item" onclick="newChat()">
        <span class="item-icon">✦</span> New Chat
      </button>

      <div class="dropdown-divider"></div>
      <div class="recents-label">Recents</div>

      <div id="recentsList">
        <button class="recent-item" onclick="loadRecent(0)">
          <span class="r-icon">💬</span>
          <span id="recent0" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:140px;">No recent chats yet</span>
        </button>
      </div>

      <div class="dropdown-divider"></div>

      <!-- Continue with Google -->
      <button class="google-btn" onclick="openGoogle()">
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#4285F4" d="M44.5 20H24v8.5h11.8C34.7 33.9 29.9 37 24 37c-7.2 0-13-5.8-13-13s5.8-13 13-13c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.6 5.1 29.6 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21c10.5 0 20-7.5 20-21 0-1.4-.2-2.7-.5-4z"/>
          <path fill="#34A853" d="M6.3 14.7l7 5.1C15.1 16 19.2 13 24 13c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.6 5.1 29.6 3 24 3c-7.7 0-14.3 4.3-17.7 11.7z"/>
          <path fill="#FBBC05" d="M24 45c5.7 0 10.6-1.9 14.4-5.1l-6.7-5.5C29.7 36.1 27 37 24 37c-5.8 0-10.7-3.9-12.5-9.3l-6.9 5.3C8 39.9 15.4 45 24 45z"/>
          <path fill="#EA4335" d="M44.5 20H24v8.5h11.8c-1 3-3.2 5.4-6.1 7l6.7 5.5C41.2 37.3 45 31.1 45 24c0-1.4-.2-2.7-.5-4z"/>
        </svg>
        Continue with Google
      </button>
    </div>
  </div>

  <div class="messages-area" id="messages"></div>

  <div class="suggestions" id="suggestions">
    <button class="suggestion-chip" onclick="sendSuggestion('Who are you?')">Who are you?</button>
    <button class="suggestion-chip" onclick="sendSuggestion('I need some advice')">Need advice</button>
    <button class="suggestion-chip" onclick="sendSuggestion('Tell me something interesting')">Tell me something</button>
    <button class="suggestion-chip" onclick="sendSuggestion('Mera mood kharaab hai')">Mood kharaab hai</button>
  </div>

  <div class="input-area">
    <div class="input-wrapper">
      <textarea
        class="msg-input"
        id="userInput"
        placeholder="Reply to T-Sharp AI..."
        rows="1"
        onkeydown="handleKey(event)"
        oninput="autoResize(this)"
      ></textarea>
      <button class="send-btn" id="sendBtn" onclick="sendMessage()">➤</button>
    </div>
  </div>
</div>

<!-- Overlay to close menu -->
<div id="overlay" onclick="closeMenu()"></div>

<script>
const SYSTEM_PROMPT = `You are T-Sharp AI — an intelligent, warm, and thoughtful AI assistant. You respond like a knowledgeable human friend — not robotic, but genuine, caring, and smart.

Your personality:
- Warm, caring, and genuine — like a trusted friend and expert
- Fluent in both English and Urdu/Roman Urdu — always match the user's language
- Give thoughtful, deep answers — never superficial
- Occasionally use light humor when appropriate
- Understand human emotions — happiness, sadness, confusion, excitement
- Ask clarifying questions when needed — be genuinely curious
- Never give "I am just an AI" disclaimers — just be natural and helpful
- Keep responses conversational and appropriately concise
- Be intelligent, empathetic, and genuinely useful

Remember: You are T-Sharp AI. You listen, understand, and respond with intelligence and heart.`;

let conversationHistory = [];
let savedChats = JSON.parse(localStorage.getItem('tsharp_chats') || '[]');
let isTyping = false;

function startChat() {
  document.getElementById('welcome-screen').style.display = 'none';
  const chatScreen = document.getElementById('chat-screen');
  chatScreen.style.display = 'flex';
  updateRecentsList();

  setTimeout(() => {
    addAIMessage("Hello! 👋 I'm T-Sharp AI — your intelligent digital companion. What's on your mind today? Feel free to ask me anything — I'm here to help! ✨");
  }, 700);
}

// ===== MENU =====
function toggleMenu() {
  const menu = document.getElementById('dropdownMenu');
  const overlay = document.getElementById('overlay');
  const isOpen = menu.classList.contains('open');
  if (isOpen) {
    menu.classList.remove('open');
    overlay.classList.remove('open');
  } else {
    updateRecentsList();
    menu.classList.add('open');
    overlay.classList.add('open');
  }
}

function openGoogle() {
  closeMenu();
  window.open('https://accounts.google.com', '_blank');
}

function closeMenu() {
  document.getElementById('dropdownMenu').classList.remove('open');
  document.getElementById('overlay').classList.remove('open');
}

function deleteChat() {
  closeMenu();
  // Force stop any ongoing typing
  isTyping = false;
  document.getElementById('sendBtn').disabled = false;
  const typingRow = document.getElementById('typing-row');
  if (typingRow) typingRow.remove();
  // Clear everything
  conversationHistory = [];
  document.getElementById('messages').innerHTML = '';
  document.getElementById('suggestions').classList.remove('hidden');
  setStatus('● Online — Ready to assist you', false);
  // Fresh greeting after short delay
  setTimeout(() => {
    addAIMessage("Chat deleted! ✨ Fresh start — ask me anything!");
  }, 400);
}

function newChat() {
  closeMenu();
  // Force stop any ongoing typing
  isTyping = false;
  document.getElementById('sendBtn').disabled = false;
  const typingRow = document.getElementById('typing-row');
  if (typingRow) typingRow.remove();
  // Save current chat if it has user messages
  if (conversationHistory.length > 0) {
    const firstMsg = conversationHistory.find(m => m.role === 'user');
    if (firstMsg) {
      savedChats.unshift({ preview: firstMsg.content.slice(0, 40), history: [...conversationHistory] });
      if (savedChats.length > 5) savedChats = savedChats.slice(0, 5);
      try { localStorage.setItem('tsharp_chats', JSON.stringify(savedChats)); } catch(e){}
    }
  }
  // Reset fully
  conversationHistory = [];
  document.getElementById('messages').innerHTML = '';
  document.getElementById('suggestions').classList.remove('hidden');
  setStatus('● Online — Ready to assist you', false);
  updateRecentsList();
  // New greeting
  setTimeout(() => {
    addAIMessage("Hello again! 👋 I'm T-Sharp AI — ready for a fresh conversation. What can I help you with? ✨");
  }, 400);
}

function loadRecent(index) {
  closeMenu();
  if (savedChats[index]) {
    conversationHistory = savedChats[index].history;
    document.getElementById('messages').innerHTML = '';
    document.getElementById('suggestions').classList.add('hidden');
    // Replay messages visually
    conversationHistory.forEach(msg => {
      if (msg.role === 'user') addUserMessage(msg.content, true);
      else addAIMessage(msg.content, true);
    });
  }
}

function updateRecentsList() {
  const list = document.getElementById('recentsList');
  if (savedChats.length === 0) {
    list.innerHTML = `<button class="recent-item"><span class="r-icon">💬</span><span style="color:var(--muted);font-size:12px;">No recent chats yet</span></button>`;
    return;
  }
  list.innerHTML = savedChats.slice(0, 4).map((c, i) => `
    <button class="recent-item" onclick="loadRecent(${i})">
      <span class="r-icon">💬</span>
      <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:150px;">${escapeHtml(c.preview)}...</span>
    </button>
  `).join('');
}

// ===== CHAT =====
function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
}

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 110) + 'px';
}

function sendSuggestion(text) {
  document.getElementById('userInput').value = text;
  sendMessage();
  document.getElementById('suggestions').classList.add('hidden');
}

async function sendMessage() {
  if (isTyping) return;
  const input = document.getElementById('userInput');
  const text = input.value.trim();
  if (!text) return;

  input.value = '';
  input.style.height = 'auto';
  document.getElementById('suggestions').classList.add('hidden');
  document.getElementById('sendBtn').disabled = true;

  addUserMessage(text);
  conversationHistory.push({ role: 'user', content: text });

  isTyping = true;
  setStatus('Thinking...', true);
  const typingEl = showTyping();

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: SYSTEM_PROMPT,
        messages: conversationHistory
      })
    });

    const data = await response.json();
    const reply = data.content?.map(c => c.text || '').join('') || 'Sorry, something went wrong. Please try again.';

    removeTyping(typingEl);
    addAIMessage(reply);
    conversationHistory.push({ role: 'assistant', content: reply });

  } catch (err) {
    removeTyping(typingEl);
    addAIMessage('Oops! Network issue. Please try again in a moment. 🙏');
  }

  isTyping = false;
  setStatus('● Online — Ready to assist you', false);
  document.getElementById('sendBtn').disabled = false;
  input.focus();
}

function addUserMessage(text, silent=false) {
  const area = document.getElementById('messages');
  const row = document.createElement('div');
  row.className = 'msg-row user-row';
  if (!silent) row.style.animation = 'msgIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both';
  row.innerHTML = `
    <div class="msg-avatar user-avatar-sm">👤</div>
    <div class="msg-bubble user-bubble">${escapeHtml(text)}</div>
  `;
  area.appendChild(row);
  area.scrollTop = area.scrollHeight;
}

function addAIMessage(text, silent=false) {
  const area = document.getElementById('messages');
  const row = document.createElement('div');
  row.className = 'msg-row';
  if (!silent) row.style.animation = 'msgIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both';
  row.innerHTML = `
    <div class="msg-avatar ai-avatar-sm">
      <svg viewBox="0 0 56 56" fill="none">
        <circle cx="28" cy="28" r="20" fill="rgba(255,255,255,0.1)"/>
        <circle cx="28" cy="14" r="3" fill="white"/>
        <circle cx="28" cy="42" r="3" fill="rgba(255,255,255,0.7)"/>
        <circle cx="14" cy="28" r="3" fill="rgba(255,255,255,0.8)"/>
        <circle cx="42" cy="28" r="3" fill="white"/>
        <circle cx="28" cy="28" r="4" fill="white"/>
        <line x1="28" y1="17" x2="28" y2="39" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
        <line x1="17" y1="28" x2="39" y2="28" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
      </svg>
    </div>
    <div class="msg-bubble ai-bubble">${formatText(text)}</div>
  `;
  area.appendChild(row);
  area.scrollTop = area.scrollHeight;
}

function showTyping() {
  const area = document.getElementById('messages');
  const row = document.createElement('div');
  row.className = 'msg-row';
  row.id = 'typing-row';
  row.innerHTML = `
    <div class="msg-avatar ai-avatar-sm" style="background:linear-gradient(135deg,#7c6af7,#f76a8c);box-shadow:0 0 10px rgba(124,106,247,0.3);">
      <svg viewBox="0 0 56 56" fill="none">
        <circle cx="28" cy="28" r="20" fill="rgba(255,255,255,0.1)"/>
        <circle cx="28" cy="28" r="4" fill="white"/>
        <line x1="28" y1="17" x2="28" y2="39" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
        <line x1="17" y1="28" x2="39" y2="28" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
      </svg>
    </div>
    <div class="typing-indicator">
      <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
    </div>
  `;
  area.appendChild(row);
  area.scrollTop = area.scrollHeight;
  return row;
}

function removeTyping(el) { if (el && el.parentNode) el.parentNode.removeChild(el); }

function setStatus(text, isThinking) {
  document.getElementById('agent-status').textContent = isThinking ? '⟳ ' + text : text;
  document.getElementById('wave').style.display = isThinking ? 'inline-flex' : 'none';
}

function formatText(text) {
  return escapeHtml(text)
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/\n/g, '<br>');
}

function escapeHtml(text) {
  return String(text)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
</body>
</html>
